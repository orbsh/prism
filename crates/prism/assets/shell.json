        {
          "type": "placeholder",
          "id": "auth-region",
          "attrs": { "class": ["--auth"] },
          "bind": { "value": { "kind": "source", "source": "auth" } }
        }
      ]
    },
    {
      "type": "case",
      "attrs": { "class": ["maximize", "col"] },
      "bind": { "value": { "kind": "source", "source": "island:gravity-model" } }
    }
  ]
}